# Hosted persistent storage
IM_DATA_ROOT=/var/data
IM_DB_PATH=/var/data/episodes.db
IM_AUDIO_DIR=/var/data/audio
IM_MODEL_DIR=/var/data/models

# Render provides PORT. Set this only for a local hosted-container smoke test.
PORT=10000

# Set to 1 only when the local Whisper runtime is installed and configured.
IM_OFFLINE=0

# Configure this secret in Render. Never commit a populated .env file.
OPENAI_API_KEY=
